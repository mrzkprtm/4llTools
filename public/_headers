# Keep the *.pages.dev copies (production and every preview) out of search
# results, so only the custom domain gets indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Basic hardening for every page. Camera, microphone and screen capture stay
# allowed for this site only, since several tools need them.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()
